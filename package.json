{
  "name": "@0628dao/emacore",
  "version": "0.1.0",
  "description": "EMA CORE ERC-20 source, Base Mainnet deployed-token verification, and Base Sepolia work",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test nodejs",
    "typecheck": "tsc --noEmit",
    "check": "npm run compile && npm run test && npm run typecheck && npm run test:read-only && npm run test:history",
    "test:history": "node --test integration/history-compatibility.test.mjs",
    "deploy:base-sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "test:identity": "node --test test/onchain-identity.test.mjs",
    "verify:base-mainnet": "node scripts/verify-base-mainnet.js",
    "test:read-only": "node --test test/*.test.mjs",
    "inspect:transfers": "node scripts/inspect-transfers.js",
    "inspect:wallet": "node scripts/inspect-wallet-readiness.js",
    "inspect:approvals": "node scripts/inspect-approvals.js",
    "quote:dex": "node scripts/quote-dex.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-keystore": "3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@types/node": "22.8.5",
    "hardhat": "3.16.0",
    "solc": "0.8.34",
    "typescript": "6.0.3",
    "viem": "2.56.6"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
